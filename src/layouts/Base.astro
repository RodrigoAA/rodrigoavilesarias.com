---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Rodrigo Avilés Arias — producto, escritura y notas.' } = Astro.props;
const pageTitle = title === 'Rodrigo Avilés Arias' ? title : `${title} · Rodrigo Avilés Arias`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
