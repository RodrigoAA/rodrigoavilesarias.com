---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = 'Rodrigo Avilés Arias: lo que pienso, y cómo va cambiando.', bodyClass } = Astro.props;
const pageTitle = title === 'Rodrigo Avilés Arias' ? title : `${title} · Rodrigo Avilés Arias`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
