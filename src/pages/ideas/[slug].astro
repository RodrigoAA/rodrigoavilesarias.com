---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fecha, ESTADOS, enLinea } from '../../lib';

export async function getStaticPaths() {
  const ideas = await getCollection('ideas');
  return ideas.map((i) => ({
    params: { slug: i.id },
    props: {
      i,
      // Ideas que mencionan a esta: en su lista de relacionadas o con un enlace en el texto.
      mencionadaEn: ideas
        .filter((o) => o.id !== i.id && (o.data.relacionadas.some((r) => r.slug === i.id) || (o.body || '').includes(`../${i.id}/`)))
        .map((o) => ({ titulo: o.data.titulo, slug: o.id })),
    },
  }));
}

const { i, mencionadaEn } = Astro.props;
const { Content } = await render(i);
const d = i.data;
const base = import.meta.env.BASE_URL;
const cambios = [...d.cambios].reverse(); // la más reciente arriba
const n = d.cambios.length;
---

<Base title={d.titulo} description={d.postura}>
  <main class="wrap idea">
    <a class="back" href={base}>← Rodrigo Avilés Arias</a>
    <article>
      <p class="meta">
        <span class={`estado ${d.estado}`}>{ESTADOS[d.estado]}</span><span>·</span>
        <span>Actualizada el {fecha(d.actualizado)}</span>
        {n > 0 && (<><span>·</span><span>postura {n}</span></>)}
      </p>
      <h1>{d.titulo}</h1>
      <p class="postura">{d.postura}</p>
      <div class="prose"><Content /></div>

      {d.preguntas.length > 0 && (<>
        <h2>Preguntas abiertas</h2>
        <ul class="preguntas">{d.preguntas.map((p) => <li set:html={enLinea(p)} />)}</ul>
      </>)}

      {n > 0 && (<>
        <h2>Cómo ha cambiado</h2>
        <ol class="tl">
          {cambios.map((c, k) => (
            <li class={k === 0 ? 'actual' : ''}>
              <div class="v"><b>{k === n - 1 ? 'Primera postura' : `Postura ${n - k}`}</b> · {c.fecha}{k === 0 ? ' · actual' : ''}</div>
              <div class={k === 0 ? 'nueva' : 'c'} set:html={enLinea(c.texto.replace(/\s*\[(\d+)\]\s*$/, ''))} />
              {/\[(\d+)\]\s*$/.test(c.texto) && (() => { const r = c.texto.match(/\[(\d+)\]\s*$/)![1]; return <div class="por">La provocó <a href={`#ref-${r}`}>[{r}]</a></div>; })()}
            </li>
          ))}
        </ol>
      </>)}

      {d.referencias.length > 0 && (<>
        <h2>Referencias</h2>
        <ol class="refs">{d.referencias.map((r, k) => <li id={`ref-${k + 1}`} set:html={enLinea(r)} />)}</ol>
      </>)}

      {d.relacionadas.length > 0 && (<>
        <h2>Enlaza a</h2>
        <ul class="rel">
          {d.relacionadas.map((r) => <li>{r.slug ? <a href={`${base}ideas/${r.slug}/`}>{r.titulo}</a> : r.titulo}</li>)}
        </ul>
      </>)}
      {mencionadaEn.length > 0 && (<>
        <h2>Mencionada en</h2>
        <ul class="rel">{mencionadaEn.map((r) => <li><a href={`${base}ideas/${r.slug}/`}>{r.titulo}</a></li>)}</ul>
      </>)}
    </article>
    <footer>Esta idea cambia con el tiempo. Última actualización: {fecha(d.actualizado)}.</footer>
  </main>
</Base>
