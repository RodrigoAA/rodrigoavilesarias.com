---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fecha } from '../lib';

const ideas = (await getCollection('ideas')).sort((a, b) => b.data.actualizado.valueOf() - a.data.actualizado.valueOf());
const base = import.meta.env.BASE_URL;
---

<Base title="Rodrigo Avilés Arias" bodyClass="home">
  <main class="wrap">
    <h1><a href={base}>Rodrigo Avilés Arias</a></h1>
    <section class="area">
      <ul class="ideas">
        {ideas.map((i) => (
          <li>
            <a class="t" href={`${base}ideas/${i.id}/`}>{i.data.titulo}</a>
            <div class="m"><span>{fecha(i.data.actualizado)}</span></div>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
