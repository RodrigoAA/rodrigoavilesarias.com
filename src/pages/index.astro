---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articulos = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });

const base = import.meta.env.BASE_URL;
---

<Base title="Rodrigo Avilés Arias">
  <main>
    <h1>Rodrigo Avilés Arias</h1>

    <ul class="article-list">
      {articulos.map((post) => (
        <li>
          <a href={`${base}articulos/${post.id}/`}>
            <div class="title">{post.data.title}</div>
            <div class="meta">{formatDate(post.data.date)}</div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
