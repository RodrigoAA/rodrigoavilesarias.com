---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articulos = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Rodrigo Avilés Arias">
  <main>
    <h1>Rodrigo Avilés Arias</h1>
    <p class="lead">
      Producto. Escribo lo que voy aprendiendo.
    </p>

    <ul class="article-list">
      {articulos.map((post) => (
        <li>
          <a href={`/articulos/${post.id}/`}>
            <div class="title">{post.data.title}</div>
            <div class="meta">{formatDate(post.data.date)}</div>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <footer class="footer">
    <a href="mailto:hola@rodrigoavilesarias.com">hola@rodrigoavilesarias.com</a>
  </footer>
</Base>
